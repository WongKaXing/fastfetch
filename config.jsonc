// Two-box layout with host label
{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "type": "kitty-direct",
        "source": "/Users/soc/.config/fastfetch/logo.png",
        "height": 16,
        "width": 36,
        "padding": {
            "top": 2,
            "left": 8,
            "right": 0
        }
    },
    "display": {
        "separator": " ",
        "constants": [
            "\u001b[90m",
            "\u001b[0;38;2;192;118;118m",
            "\u001b[0;38;2;192;148;116m",
            "\u001b[0;38;2;187;168;110m",
            "\u001b[0;38;2;159;177;105m",
            "\u001b[0;38;2;113;173;106m",
            "\u001b[0;38;2;92;163;118m",
            "\u001b[0;38;2;88;158;141m",
            "\u001b[0;38;2;89;153;170m",
            "\u001b[0;38;2;128;155;207m",
            "\u001b[0;38;2;142;130;201m",
            "\u001b[0;38;2;163;126;190m",
            "\u001b[0;38;2;176;108;161m",
            "\u001b[0;38;2;185;112;145m"
        ]
    },
    "modules": [
        "break",
        {
            "type": "custom",
            "key": "  {$1}╭─────────────────────────────────────────╮",
            "format": ""
        },
        {
            "type": "os",
            "key": "    {$2}{icon} OS",
            "format": ":  {pretty-name}"
        },
        {
            "type": "cpu",
            "key": "    {$3}{icon} CPU",
            "showPeCoreCount": true,
            "temp": true,
            "format": ":  {name}"
        },
        {
            "type": "gpu",
            "key": "    {$4}{icon} GPU",
            "detectionMethod": "auto",
            "driverSpecific": true,
            "format": ":  {name}"
        },
        {
            "type": "disk",
            "key": "    {$5}{icon} Disk",
            "format": ":  {size-used} / {size-total} ({size-percentage})"
        },
        {
            "type": "memory",
            "key": "    {$6}{icon} Memory",
            "format": ":  {used} / {total} ({percentage})"
        },
        {
            "type": "shell",
            "key": "    {$7}{icon} Shell",
            "format": ":  {pretty-name}"
        },
        {
            "type": "custom",
            "key": "  {$1}╰─────────────────────────────────────────╯",
            "format": ""
        },
        "break",
        {
            "type": "host",
            "key": "    {$8}{icon} Machine",
            "format": ":  {name}"
        },
        {
            "type": "custom",
            "key": "  {$1}╭─────────────────────────────────────────╮",
            "format": ""
        },
        {
            "type": "terminal",
            "key": "    {$9}{icon} Terminal",
            "format": ":  {pretty-name}"
        },
        {
            "type": "terminalfont",
            "key": "    {$10}{icon} Font",
            "format": ":  {name}"
        },
        {
            "type": "localip",
            "key": "    {$11}{icon} Local IPv4",
            "showPrefixLen": true,
            "showIpv4": true,
            "showIpv6": false,
            "showMtu": true,
            "format": ":  {ifname}: {ipv4}"
        },
        {
            "type": "publicip",
            "key": "    {$12}{icon} Public IPv4",
            "ipv6": false,
            "format": ":  {ip}"
        },
        {
            "type": "uptime",
            "key": "    {$13}{icon} Uptime",
            "format": ":  {?days}{days} Days + {?}{hours}:{minutes}:{seconds}"
        },
        {
            "type": "datetime",
            "key": "    {$14}{icon} Datetime",
            "format": ":  {year}-{month-pretty}-{day-in-month} {hour-pretty}:{minute-pretty}:{second-pretty}  {weekday-short}"
        },
        {
            "type": "custom",
            "key": "  {$1}╰─────────────────────────────────────────╯",
            "format": ""
        }
    ]
}
